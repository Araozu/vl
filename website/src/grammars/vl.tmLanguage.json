{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "vl",
  "displayName": "VL",
  "scopeName": "source.vl",
  "fileTypes": ["vl"],
  "aliases": ["VL"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#type-definition" },
    { "include": "#object-literal" },
    { "include": "#function-definition" },
    { "include": "#keyword" },
    { "include": "#boolean" },
    { "include": "#number" },
    { "include": "#turbofish" },
    { "include": "#function-call" },
    { "include": "#capability" },
    { "include": "#type" },
    { "include": "#operator" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.double-slash.vl",
      "match": "//.*$"
    },
    "string": {
      "name": "string.quoted.double.vl",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        {
          "name": "constant.character.escape.vl",
          "match": "\\\\(?:0|n|r|t|\\\\|\")"
        },
        {
          "name": "invalid.illegal.unknown-escape.vl",
          "match": "\\\\."
        }
      ]
    },
    "type-definition": {
      "name": "meta.type.definition.vl",
      "begin": "\\b(type)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(=)\\s*(object)\\s*(\\{)",
      "beginCaptures": {
        "1": { "name": "keyword.declaration.vl" },
        "2": { "name": "entity.name.type.vl" },
        "3": { "name": "keyword.operator.assignment.vl" },
        "4": { "name": "keyword.declaration.vl" },
        "5": { "name": "punctuation.bracket.curly.vl" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.bracket.curly.vl" }
      },
      "patterns": [
        { "include": "#comment" },
        { "include": "#function-definition" },
        { "include": "#block" },
        {
          "name": "meta.field.declaration.vl",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(:)",
          "captures": {
            "1": { "name": "variable.other.property.vl" },
            "2": { "name": "punctuation.separator.annotation.vl" }
          }
        },
        { "include": "#type" },
        {
          "name": "punctuation.bracket.square.vl",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.separator.vl",
          "match": ","
        }
      ]
    },
    "block": {
      "name": "meta.block.vl",
      "begin": "\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.bracket.curly.vl" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.bracket.curly.vl" }
      },
      "patterns": [
        { "include": "#block" },
        { "include": "#comment" },
        { "include": "#string" },
        { "include": "#object-literal" },
        { "include": "#keyword" },
        { "include": "#boolean" },
        { "include": "#number" },
        { "include": "#turbofish" },
        { "include": "#function-call" },
        { "include": "#capability" },
        { "include": "#type" },
        { "include": "#operator" },
        { "include": "#punctuation" }
      ]
    },
    "object-literal": {
      "name": "meta.object.literal.vl",
      "begin": "\\b([A-Z][A-Za-z0-9_]*)\\s*(\\{)(?=\\s*[A-Za-z_][A-Za-z0-9_]*\\s*=|\\s*\\})",
      "beginCaptures": {
        "1": { "name": "entity.name.type.vl" },
        "2": { "name": "punctuation.bracket.curly.vl" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.bracket.curly.vl" }
      },
      "patterns": [
        { "include": "#comment" },
        { "include": "#string" },
        { "include": "#object-literal" },
        {
          "name": "meta.field.assign.vl",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(=)",
          "captures": {
            "1": { "name": "variable.other.property.vl" },
            "2": { "name": "keyword.operator.assignment.vl" }
          }
        },
        { "include": "#turbofish" },
        { "include": "#function-call" },
        { "include": "#keyword" },
        { "include": "#boolean" },
        { "include": "#number" },
        { "include": "#type" },
        { "include": "#operator" },
        { "include": "#punctuation" }
      ]
    },
    "function-definition": {
      "name": "meta.function.definition.vl",
      "begin": "\\b(fun)\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*[\\[(])",
      "beginCaptures": {
        "1": { "name": "keyword.declaration.vl" },
        "2": { "name": "entity.name.function.vl" }
      },
      "end": "\\)",
      "endCaptures": {
        "0": { "name": "punctuation.definition.parameters.end.vl" }
      },
      "patterns": [
        { "include": "#comment" },
        { "include": "#type-params" },
        { "include": "#keyword" },
        { "include": "#type" },
        {
          "name": "variable.parameter.vl",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        },
        {
          "name": "punctuation.separator.parameter.vl",
          "match": ","
        },
        {
          "name": "punctuation.definition.parameters.begin.vl",
          "match": "\\("
        },
        {
          "name": "punctuation.separator.annotation.vl",
          "match": ":"
        },
        {
          "name": "punctuation.bracket.square.vl",
          "match": "[\\[\\]]"
        }
      ]
    },
    "type-params": {
      "name": "meta.type.parameters.vl",
      "begin": "\\[",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.generic.begin.vl" }
      },
      "end": "\\]",
      "endCaptures": {
        "0": { "name": "punctuation.definition.generic.end.vl" }
      },
      "patterns": [
        { "include": "#comment" },
        { "include": "#keyword" },
        { "include": "#type" },
        {
          "name": "entity.name.type.parameter.vl",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        },
        {
          "name": "punctuation.separator.generic.vl",
          "match": ","
        }
      ]
    },
    "turbofish": {
      "name": "meta.turbofish.vl",
      "begin": "(::)\\s*(\\[)",
      "beginCaptures": {
        "1": { "name": "punctuation.separator.turbofish.vl" },
        "2": { "name": "punctuation.definition.generic.begin.vl" }
      },
      "end": "\\]",
      "endCaptures": {
        "0": { "name": "punctuation.definition.generic.end.vl" }
      },
      "patterns": [
        { "include": "#comment" },
        { "include": "#type" },
        {
          "name": "punctuation.separator.generic.vl",
          "match": ","
        },
        {
          "name": "punctuation.bracket.square.vl",
          "match": "[\\[\\]]"
        }
      ]
    },
    "type": {
      "patterns": [
        {
          "name": "storage.modifier.capability.vl",
          "match": "\\*(?=\\s*(?:u64|i64|f64|bool|u8|void|String|File|Array|[A-Z]))"
        },
        {
          "name": "storage.type.primitive.vl",
          "match": "\\b(?:u64|i64|f64|bool|u8|void)\\b"
        },
        {
          "name": "storage.type.reference.vl",
          "match": "\\b(?:String|File)\\b"
        },
        {
          "name": "storage.type.array.vl",
          "match": "\\bArray\\b"
        },
        {
          "name": "storage.type.bound.vl",
          "match": "\\b(?:Numeric|Comparable)\\b"
        },
        {
          "name": "entity.name.type.vl",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.declaration.vl",
          "match": "\\b(?:var|val|fun|use|type|object|as|extends)\\b"
        },
        {
          "name": "keyword.control.conditional.vl",
          "match": "\\b(?:if|else)\\b"
        },
        {
          "name": "keyword.control.loop.vl",
          "match": "\\b(?:while|break|continue|return)\\b"
        }
      ]
    },
    "boolean": {
      "name": "constant.language.boolean.vl",
      "match": "\\b(?:true|false)\\b"
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.float.vl",
          "match": "\\b\\d+\\.\\d+f64\\b"
        },
        {
          "name": "constant.numeric.integer.vl",
          "match": "\\b\\d+(?:i64|u64|u8)\\b"
        },
        {
          "name": "invalid.illegal.numeric.vl",
          "match": "\\b\\d+(?:\\.\\d+)?[A-Za-z_]\\w*|\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.vl",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "function-call": {
      "name": "entity.name.function.call.vl",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*(?=\\s*::\\s*\\[|\\s*\\()"
    },
    "capability": {
      "name": "storage.modifier.capability.vl",
      "match": "(?:(?<=:)|(?<=\\[)|(?<=,))\\s*\\*(?=\\s*(?:u64|i64|f64|bool|u8|void|String|File|Array|[A-Z]))"
    },
    "operator": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.vl",
          "match": "[+\\-*/]"
        },
        {
          "name": "keyword.operator.comparison.vl",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.vl",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.assignment.vl",
          "match": "="
        },
        {
          "name": "punctuation.separator.turbofish.vl",
          "match": "::"
        },
        {
          "name": "punctuation.separator.annotation.vl",
          "match": ":"
        },
        {
          "name": "punctuation.separator.vl",
          "match": "[;,]"
        },
        {
          "name": "punctuation.accessor.dot.vl",
          "match": "\\."
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.bracket.round.vl",
          "match": "[()]"
        },
        {
          "name": "punctuation.bracket.curly.vl",
          "match": "[{}]"
        },
        {
          "name": "punctuation.bracket.square.vl",
          "match": "[\\[\\]]"
        }
      ]
    }
  }
}
