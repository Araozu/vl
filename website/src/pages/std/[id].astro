---
import { getCollection } from 'astro:content';
import Docs from '../../layouts/Docs.astro';
import { renderInline, renderParagraphs, slug } from '../../lib/md';
import { highlightVl } from '../../lib/vl-code';

function signature(module: string, fn: {
  name: string;
  params: Array<{ name: string; type: string }>;
  returns: { type: string };
}): string {
  const params = fn.params.map((p) => `${p.name}: ${p.type}`).join(', ');
  return `${module}.${fn.name}(${params}) -> ${fn.returns.type}`;
}

export async function getStaticPaths() {
  const modules = await getCollection('stdlib');
  return modules.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const mod = entry.data;
const importHtml = await highlightVl(mod.import_example);
const exampleHtml = new Map<string, string>();
for (const fn of mod.functions) {
  if (fn.example) exampleHtml.set(fn.name, await highlightVl(fn.example));
}
---

<Docs
  title={mod.title}
  description={mod.description}
  eyebrow="Standard library"
  availability="VL 0.1+"
>
  <h1 id={slug(mod.module)}><code>{mod.module}</code></h1>
  <Fragment set:html={renderParagraphs(mod.intro)} />
  <Fragment set:html={importHtml} />
  {
    mod.functions.map((fn) => {
      const head = signature(mod.module, fn);
      return (
        <Fragment>
          <h2 id={slug(head)}>
            <code>{head}</code>
          </h2>
          <table>
            <thead>
              <tr>
                <th>Parameter</th>
                <th>Type</th>
                <th>Description</th>
              </tr>
            </thead>
            <tbody>
              {fn.params.map((p) => (
                <tr>
                  <td>
                    <code>{p.name}</code>
                  </td>
                  <td>
                    <code>{p.type}</code>
                  </td>
                  <td>
                    {p.detail ? <Fragment set:html={renderInline(p.detail)} /> : null}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
          <p>
            <strong>Returns</strong> <code>{fn.returns.type}</code>
            {fn.returns.detail ? (
              <>
                {' — '}
                <Fragment set:html={renderInline(fn.returns.detail)} />
              </>
            ) : (
              '.'
            )}
          </p>
          <Fragment set:html={renderParagraphs(fn.detail)} />
          {fn.example && <Fragment set:html={exampleHtml.get(fn.name)} />}
        </Fragment>
      );
    })
  }
  {mod.outro && <Fragment set:html={renderParagraphs(mod.outro)} />}
</Docs>
