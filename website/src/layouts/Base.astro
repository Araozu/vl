---
interface Props {
  title?: string;
  description?: string;
}
const { title = 'VL Documentation', description = 'Documentation for the VL programming language.' } = Astro.props;
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-canvas font-sans text-body antialiased">
    <!-- Top developer bar, Swift-docs style -->
    <header class="sticky top-0 z-40 border-b border-rule bg-header/95 backdrop-blur">
      <nav class="mx-auto flex h-12 max-w-[1400px] items-center justify-between gap-4 px-4 sm:px-6">
        <a href="/" class="flex items-baseline gap-1.5 text-[1.05rem] font-semibold tracking-tight text-ink">
          <span aria-hidden="true" class="text-[1rem]">◼</span> VL&nbsp;<span class="font-normal text-muted">Developer</span>
        </a>
        <div class="hidden items-center gap-6 text-[0.82rem] text-body lg:flex">
          <a href="/docs/getting-started" class="transition hover:text-ink">Get Started</a>
          <a href="/docs/language" class="transition hover:text-ink">Language</a>
          <a href="/api" class="transition hover:text-ink">API</a>
          <a href="/docs" class="text-ink">Documentation</a>
          <a href="/cli" class="transition hover:text-ink">CLI</a>
          <a href="/internals" class="transition hover:text-ink">Internals</a>
        </div>
        <div class="flex items-center gap-3">
          <a href="/docs" aria-label="Search" class="rounded-md p-1.5 text-body transition hover:text-ink">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="7" cy="7" r="4.5"/><path d="M10.5 10.5 14 14"/></svg>
          </a>
          <a href="/docs" class="rounded-full bg-accent px-3.5 py-1 text-[0.8rem] font-medium text-white transition hover:brightness-110">Sign in</a>
        </div>
      </nav>
    </header>
    <!-- Documentation bar -->
    <div class="border-b border-rule bg-canvas">
      <div class="mx-auto flex h-14 max-w-[1400px] items-center justify-between px-4 sm:px-6">
        <a href="/docs" class="flex items-center gap-2.5 text-[1.15rem] font-semibold tracking-tight text-ink">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" class="text-muted" aria-hidden="true"><rect x="1.5" y="2.5" width="15" height="13" rx="2"/><path d="M6 2.5v13M1.5 6H6"/></svg>
          Documentation
        </a>
        <p class="text-[0.82rem] text-muted">Language: <span class="text-body">VL</span></p>
      </div>
    </div>
    <main>
      <slot />
    </main>
    <footer class="border-t border-rule bg-canvas py-8">
      <div class="mx-auto flex max-w-[1400px] flex-col gap-1 px-4 text-[0.8rem] text-faint sm:flex-row sm:items-baseline sm:justify-between sm:px-6">
        <p>VL — a small language with a legible compiler.</p>
        <p>Set in Inter. Respects your system appearance.</p>
      </div>
    </footer>
  </body>
</html>
