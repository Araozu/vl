---
interface Props {
  title?: string;
  description?: string;
}
const { title = 'VL — the handbook', description = 'Documentation and API reference for the VL programming language.' } = Astro.props;
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-night font-display text-parchment antialiased">
    <header class="sticky top-0 z-40 border-b border-rule bg-night/95 backdrop-blur">
      <nav class="mx-auto flex h-16 max-w-5xl items-baseline justify-between px-4 sm:px-6">
        <a href="/" class="text-[1.35rem] font-semibold leading-none tracking-tight">
          VL <span class="ml-2 align-middle text-[0.95rem] font-normal italic text-muted">the handbook, v0</span>
        </a>
        <div class="flex items-baseline gap-6 text-[1.05rem]">
          <a href="/docs" class="text-muted transition hover:text-gold">Documentation</a>
          <a href="/api" class="text-muted transition hover:text-gold">API</a>
        </div>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="border-t border-rule py-10">
      <div class="mx-auto flex max-w-5xl flex-col gap-1.5 px-4 text-[0.95rem] text-muted sm:flex-row sm:items-baseline sm:justify-between sm:px-6">
        <p><em>VL, a small language with a legible compiler.</em></p>
        <p>Set in Fraunces and IBM Plex Mono.</p>
      </div>
    </footer>
  </body>
</html>
