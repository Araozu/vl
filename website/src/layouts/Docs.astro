---
import { getCollection } from 'astro:content';
import Base from './Base.astro';

interface Props {
  title?: string;
  description?: string;
  eyebrow?: string;
  availability?: string;
}
const fm = (Astro.props as { frontmatter?: Record<string, unknown> }).frontmatter ?? {};
const title = (fm.title as string | undefined) ?? (Astro.props as Props).title ?? 'Documentation';
const description = (fm.description as string | undefined) ?? (Astro.props as Props).description;
const eyebrow = (fm.eyebrow as string | undefined) ?? (Astro.props as Props).eyebrow ?? 'Article';
const availability = (fm.availability as string | undefined) ?? (Astro.props as Props).availability ?? 'VL 0.1+';

// Sidebar mirrors the Swift reference: back link, product title, grey
// section labels, icon rows, one selected pill, filter box pinned bottom.
// Each top-level section (docs, std, cli, internals) is its own group with
// its own sidebar; the navbar switches sections, the sidebar never mixes them.
const pathname = Astro.url.pathname;
const section = pathname.startsWith('/std')
  ? 'std'
  : pathname.startsWith('/cli')
    ? 'cli'
    : pathname.startsWith('/internals')
      ? 'internals'
      : 'docs';
// The std sidebar (and its pages) is generated from the stdlib catalog,
// so adding a module to `src/data/stdlib.yaml` updates both at once.
const stdModules = (await getCollection('stdlib')).sort((a, b) => a.data.order - b.data.order);
const sectionSidebars = {
  docs: {
    root: '/docs',
    groups: [
      {
        label: 'Learn VL',
        items: [
          { href: '/docs', label: 'Learning path', icon: 'doc' },
          { href: '/docs/getting-started', label: 'Getting started', icon: 'doc' },
          { href: '/docs/basics', label: '1. Basics', icon: '1' },
          { href: '/docs/control-flow', label: '2. Conditions and loops', icon: '2' },
          { href: '/docs/functions', label: '3. Functions', icon: '3' },
          { href: '/docs/arrays', label: '4. Arrays and generics', icon: '4' },
          { href: '/docs/objects', label: '5. Objects', icon: '5' },
          { href: '/docs/unions', label: '6. Unions', icon: '6' },
          { href: '/docs/strings', label: '7. Strings', icon: '7' },
          { href: '/docs/modules', label: '8. Modules', icon: '8' },
        ],
      },
    ],
  },
  std: {
    root: '/std',
    groups: [
      {
        label: 'Standard library',
        items: [
          { href: '/std', label: 'Overview', icon: 'doc' as const },
          ...stdModules.map((m) => ({
            href: `/std/${m.id}`,
            label: m.data.module,
            icon: 'S' as const,
          })),
        ],
      },
    ],
  },
  cli: {
    root: '/cli',
    groups: [
      {
        label: 'Command line',
        items: [{ href: '/cli', label: 'CLI reference', icon: 'M' }],
      },
    ],
  },
  internals: {
    root: '/internals',
    groups: [
      {
        label: 'For contributors',
        items: [
          { href: '/internals', label: 'Compiler internals', icon: 'doc' },
          { href: '/internals/driver', label: 'Driver', icon: 'S' },
          { href: '/internals/frontend', label: 'Frontend crates', icon: 'S' },
          { href: '/internals/backend', label: 'Backend crates', icon: 'S' },
          { href: '/internals/compiler-service', label: 'Compiler service', icon: 'S' },
        ],
      },
    ],
  },
} as const;
const { root: sectionRoot, groups } = sectionSidebars[section];

// Breadcrumb: "VL / <page>"
const shortTitle = String(title).split('·')[0].split('|')[0].trim();
---

<Base title={title} description={description}>
  <div class="mx-auto max-w-[1400px]">
    <div class="grid lg:grid-cols-[300px_minmax(0,1fr)]">
      <!-- Sidebar -->
      <aside class="hidden border-r border-rule lg:flex lg:min-h-[calc(100vh-6.5rem)] lg:flex-col">
        <nav class="flex-1 px-3 py-4" aria-label="Documentation">
          <a href="/" class="flex items-center gap-1.5 px-2 py-1.5 text-[0.83rem] font-medium text-body transition hover:text-ink">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M7.5 2 4 6l3.5 4"/></svg>
            All Technologies
          </a>
          <p class="px-2 pb-1 pt-3 text-[0.98rem] font-bold tracking-tight text-ink">VL</p>
          {
            groups.map((group) => (
              <div class="mt-2">
                <p class="px-2 py-1 text-[0.82rem] font-medium text-muted">{group.label}</p>
                <ul>
                  {group.items.map((item) => {
                    const isCurrent = pathname === item.href && !(item as { stub?: boolean }).stub;
                    return (
                      <li>
                        <a
                          href={item.href}
                          aria-current={isCurrent ? 'page' : undefined}
                          class="side-link mt-px flex items-center gap-2 rounded-md px-2 py-[0.42rem] text-[0.85rem] text-body transition hover:text-ink"
                        >
                          {item.icon === 'doc' ? (
                            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.3" class="flex-none text-faint" aria-hidden="true"><path d="M3 1.8h5.2L11 4.6V12.2H3V1.8Z"/><path d="M8 1.8v2.8h3"/></svg>
                          ) : (
                            <span class="side-badge" aria-hidden="true">{item.icon}</span>
                          )}
                          <span class="truncate">{item.label}</span>
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </div>
            ))
          }
        </nav>
        <div class="sticky bottom-0 border-t border-rule bg-canvas p-3">
          <div class="flex items-center gap-2">
            <label class="flex flex-1 items-center gap-2 rounded-lg border border-rule bg-panel px-3 py-1.5 text-[0.83rem] text-faint">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M1.5 3.5h11M3.5 7h7M5.5 10.5h3"/></svg>
              <input type="search" placeholder="Filter" class="w-full bg-transparent text-body outline-none placeholder:text-faint" />
            </label>
            <kbd class="rounded-lg border border-rule bg-panel px-2.5 py-1.5 font-mono text-[0.8rem] text-muted">/</kbd>
          </div>
        </div>
      </aside>

      <!-- Mobile nav: horizontal strip for the current section -->
      <nav class="flex gap-2 overflow-x-auto border-b border-rule px-4 py-3 lg:hidden" aria-label="Documentation">
        {
          groups.flatMap((group) =>
            group.items.map((item) => (
              <a
                href={item.href}
                class="whitespace-nowrap rounded-md px-2.5 py-1.5 text-[0.85rem] text-muted"
              >
                {item.label}
              </a>
            )),
          )
        }
      </nav>

      <!-- Content -->
      <div class="min-w-0 px-5 py-8 sm:px-10 lg:px-16 lg:py-10">
        <p class="text-[0.82rem] text-muted"><a href={sectionRoot} class="underline decoration-rule underline-offset-4 hover:text-body">VL</a> / {shortTitle}</p>
        <p class="mt-6 text-[0.95rem] font-medium text-muted">{eyebrow}</p>
        <div class="docs-prose">
          <slot />
        </div>
        <p class="mt-5 text-[0.8rem] text-muted">{availability}</p>
      </div>
    </div>
  </div>
</Base>
