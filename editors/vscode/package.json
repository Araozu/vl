{
  "name": "vl-language-support",
  "displayName": "VL Language Support",
  "description": "Syntax highlighting and language server client for the VL programming language.",
  "version": "0.1.0",
  "packageManager": "pnpm@12.4.2",
  "publisher": "vl-lang",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Araozu/vl.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "vl",
    "language",
    "syntax highlighting"
  ],
  "main": "./client/out/extension.js",
  "activationEvents": [
    "onLanguage:vl"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "package": "pnpm build && vsce package --out vl-language-support.vsix",
    "vscode:prepublish": "pnpm build"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/vscode": "1.96.0",
    "@vscode/vsce": "3.6.2",
    "typescript": "5.7.2"
  },
  "contributes": {
    "languages": [
      {
        "id": "vl",
        "aliases": [
          "VL",
          "vl"
        ],
        "extensions": [
          ".vl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "vl",
        "scopeName": "source.vl",
        "path": "./syntaxes/vl.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "VL",
      "properties": {
        "vl.server.path": {
          "type": "string",
          "default": "vl",
          "description": "Path to the `vl` binary (the language server runs as `vl lsp`)."
        }
      }
    }
  }
}
