// Standard library v1: VM natives plus VL helpers in real modules.
//
// Thin externs (`std.string`, `std.math`, `std.fmt`) map to natives the VM
// already registers; `std.net.tcp` maps to the fallible `std::net::tcp`
// natives, whose `rv10` statuses lower to typed `TcpError!T` values (see
// `examples/tcp.vl`). Helpers (`math.max_u64`, `string.is_empty`, ...,
// plus the generic `math.max[T extends Numeric]`) live in embedded `std/*.vl`
// sources merged into the same module view and linked inline. Everything
// needs an explicit `use`. Untyped fallible natives (`byte_at`, `slice`)
// and `std.fs` stay out until they get the same checked treatment.
use std;
use std.string;
use std.math;
use std.fmt;

fun main() {
    val greeting = string.concat("Hello, ", "stdlib!");
    std.print(greeting);
    std.print_u64(string.len(greeting));
    std.print_u64(math.mod_u64(17u64, 5u64));
    std.print_u64(string.to_u64("42"));
    std.print(fmt.u64_to_string(math.max_u64(3u64, 9u64)));
    std.print(fmt.u64_to_string(math.max(3u64, 9u64)));
    std.print(fmt.u64_to_string(math.max::[u64](1u64, 2u64)));
    if (string.is_empty("x")) {
        std.print("unreachable\n");
    } else {
        std.print("non-empty\n");
    }
    if (math.is_even(4u64)) {
        std.print("even\n");
    }
}
