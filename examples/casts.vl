// Explicit numeric conversions (`value as u8`).
//
// Integer-to-integer only in v0: literals are range-checked at compile time
// (`300 as u8` fails), variables reinterpret unchecked with no runtime cost.
// Implicit cross-integer conversions stay narrow (literals only); variables
// require `as`.
use std;

fun take_u8(x: u8): u8 {
    return x;
}

fun main() {
    let v = 200u64;
    let w = take_u8(v as u8);
    std.print_u64(w as u64);
    let lit = 10 as u8;
    std.print_u64(lit as u64);
}
