use std;

type Counter = object {
    value: u64,
    label: String,
};

fun bump(counter: *Counter): *Counter {
    counter.value = counter.value + 1;
    return counter;
}

fun main() {
    let counter: *Counter = Counter { value = 1, label = "count" };
    let same = bump(counter);
    same.value = same.value + 1;
    std.print(same.label);
    std.print_u64(counter.value);
}
