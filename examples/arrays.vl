// Fixed-length heap arrays (`Array[T]`).
//
// `Array.new::[u64](n)` allocates a zero-filled array of `n` elements,
// `[1, 2]` is an array literal, `a[i]` reads element `i`, and
// `a[i] = v;` writes it. Indices are always `u64`; elements have the
// array's `T`.
use std;

function sum(a: Array[u64], n: u64): u64 {
    let total = 0;
    let i = 0;
    while (i < n) {
        total = total + a[i];
        i = i + 1;
    }
    return total;
}

function main() {
    let a = Array.new::[u64](3);
    a[0] = 10;
    a[1] = 20;
    a[2] = 30;
    let b = [1, 2, 3];
    b[0] = 5;
    std.print_u64(sum(a, 3));
    std.print_u64(sum(b, 3));
}
