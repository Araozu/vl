// Fixed-length heap arrays of `u64` (`U64Array`).
//
// `U64Array.new(n)` allocates a zero-filled array of `n` elements,
// `[1u64, 2u64]` is an array literal, `a[i]` reads element `i`, and
// `a[i] = v;` writes it. Indices and elements are always `u64`.
use std;

function sum(a: U64Array, n: u64): u64 {
    let total = 0u64;
    let i = 0u64;
    while (i < n) {
        total = total + a[i];
        i = i + 1u64;
    }
    return total;
}

function main() {
    let a = U64Array.new(3u64);
    a[0u64] = 10u64;
    a[1u64] = 20u64;
    a[2u64] = 30u64;
    let b = [1u64, 2u64, 3u64];
    b[0u64] = 5u64;
    std.print_u64(sum(a, 3u64));
    std.print_u64(sum(b, 3u64));
}
